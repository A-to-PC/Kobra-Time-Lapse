<Window x:Class="KobraTimeLapse.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kobra Time Lapse -- Setup" Height="700" Width="520" MinHeight="400" MinWidth="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}">
    <!-- Shared control styles (TextBox, PasswordBox, ComboBox, etc.) live in App.xaml so
         every window stays visually consistent and theme-aware from one place. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Set up Kobra Time Lapse" FontWeight="Bold" FontSize="18"/>
            <TextBlock Text="Watches your Kobra 3's own LAN protocol for print state -- no Moonraker needed -- and grabs frames from a camera while it prints." Style="{StaticResource Hint}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-16,0" Padding="0,0,16,0">
        <StackPanel>
            <TextBlock Text="Printer IP" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBox x:Name="PrinterHostBox"/>
            <TextBlock Text="Your Kobra 3's LAN IP address -- the same one Slicer Next or Kobra LAN Monitor connects to." Style="{StaticResource Hint}"/>

            <TextBlock Text="Camera IP" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBox x:Name="CameraHostBox"/>
            <TextBlock Text="Your RTSP-capable camera's LAN IP address." Style="{StaticResource Hint}"/>

            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Camera username" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBox x:Name="CameraUsernameBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Camera password" FontWeight="Bold" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="CameraPasswordBox"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="The camera's own local RTSP account -- often separate from any cloud app login (e.g. many EZVIZ/Hikvision-family cameras use 'admin' plus a device-specific password on a label, not the app account)." Style="{StaticResource Hint}"/>

            <TextBlock Text="Features (run either or both)" FontWeight="Bold" Margin="0,0,0,2"/>
            <CheckBox x:Name="EnableTimelapseCheck" Content="Timelapse -- record and assemble a video of the print" IsChecked="True" Margin="0,0,0,6"/>
            <CheckBox x:Name="EnableFailureDetectionCheck" Content="Failure detection -- flag a large sudden change between frames" IsChecked="False" Checked="EnableFailureDetectionCheck_Changed" Unchecked="EnableFailureDetectionCheck_Changed" Margin="0,0,0,2"/>
            <TextBlock Text="Expect false positives from things like an enclosure light/roller-door change, not just a real failure -- this needs tuning against your own real prints before it's trustworthy." Style="{StaticResource Hint}"/>
            <Grid x:Name="SensitivityRow" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Similarity threshold (%)" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBox x:Name="SensitivityBox"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="30-95. The exact number the log reports (e.g. &quot;threshold 60%&quot;) -- lower = only flags bigger changes, fewer false positives. Start low and raise it once you've seen how noisy your setup is." Style="{StaticResource Hint}" Margin="10,20,0,0" VerticalAlignment="Top"/>
            </Grid>
            <CheckBox x:Name="AutoCalibrationCheck" Content="Auto-calibrate per print" IsChecked="False" Margin="0,0,0,2"/>
            <TextBlock Text="The right threshold genuinely varies by print size/geometry -- a wide print naturally has more normal frame-to-frame motion than a small one. When on, the threshold above is still used as a safety net for the first ~15 comparisons of each print, then this print's own normal noise floor takes over (only ever getting more tolerant, never less, than the setting above)." Style="{StaticResource Hint}"/>
            <CheckBox x:Name="AutoPauseCheck" Content="Automatically pause the print when an anomaly is detected" IsChecked="False" Margin="0,0,0,2"/>
            <TextBlock Text="Off by default for good reason -- a false positive would pause a perfectly good print. Leave this off until you've watched the log against a few real prints and trust the sensitivity setting." Style="{StaticResource Hint}"/>

            <TextBlock Text="Save location (snapshots + finished video)" FontWeight="Bold" Margin="0,0,0,2"/>
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="OutputFolderBox" Grid.Column="0"/>
                <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse..." Padding="10,2" Click="BrowseButton_Click"/>
            </Grid>
            <TextBlock Text="Where captured frames and the finished timelapse.mp4 get saved, one subfolder per print. A network share/mapped drive works fine here." Style="{StaticResource Hint}"/>

            <CheckBox x:Name="DeleteFramesCheck" Content="Delete the individual snapshot frames once the video is assembled" IsChecked="True" Margin="0,4,0,10"/>

            <TextBlock Text="Camera rotation" FontWeight="Bold" Margin="0,0,0,2"/>
            <ComboBox x:Name="RotationCombo" SelectedIndex="0">
                <ComboBoxItem Content="None"/>
                <ComboBoxItem Content="90 degrees clockwise"/>
                <ComboBoxItem Content="180 degrees"/>
                <ComboBoxItem Content="90 degrees counter-clockwise"/>
            </ComboBox>
            <TextBlock Text="If the camera is mounted sideways (e.g. portrait, to better frame a tall printer), pick the rotation that makes the recorded frames come out upright." Style="{StaticResource Hint}"/>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="ErrorText" Foreground="#c0392b" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="ContinueButton" Content="Save and Continue" Padding="16,6" Click="ContinueButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
