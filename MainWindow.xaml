<Window x:Class="KobraTimeLapse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kobra Time Lapse" Height="480" Width="640" MinHeight="420" MinWidth="560"
        Background="{DynamicResource WindowBackgroundBrush}">
    <!-- Shared control styles (TextBox, PasswordBox, ComboBox, etc.) live in App.xaml so
         every window stays visually consistent and theme-aware from one place. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <CheckBox x:Name="ManualModeCheck" Content="Manual mode -- I'll click Start/Stop myself (no printer connection needed)"
                      Margin="0,0,0,8" Checked="ManualModeCheck_Changed" Unchecked="ManualModeCheck_Changed"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Poll/capture (s)" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBox x:Name="IntervalBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Assemble FPS" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBox x:Name="FramerateBox"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="ffmpeg path (or just 'ffmpeg' if on PATH)" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBox x:Name="FfmpegPathBox"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Printer, camera, save location, features, and rotation are configured via Setup." Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="11" Margin="0,0,0,8"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="StartStopButton" Content="Start Watching" Padding="16,6" Click="StartStopButton_Click"/>
                <Button x:Name="SetupButton" Content="Setup..." Padding="16,6" Margin="8,0,0,0" Click="SetupButton_Click"/>
                <TextBlock x:Name="StatusText" Text="Idle" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="ThemeCombo" Width="80" SelectionChanged="ThemeCombo_SelectionChanged">
                    <ComboBoxItem Content="Auto"/>
                    <ComboBoxItem Content="Light"/>
                    <ComboBoxItem Content="Dark"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <ListBox x:Name="LogList" Grid.Row="2" FontFamily="Consolas" FontSize="12"/>

        <TextBlock Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                   Text="Watches the Kobra 3's own LAN protocol for print state (no Moonraker needed). Grabs a frame from the RTSP camera every interval while a print is running, and assembles a timelapse.mp4 automatically once the print finishes, is cancelled, or errors."/>
    </Grid>
</Window>
